[
  {
    "type": "function",
    "name": "set_screen_layer",
    "description": "Turn one map layer on or off on one screen, or on every screen.",
    "parameters": {
      "type": "object",
      "properties": {
        "screen": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "all"
          ]
        },
        "layer": {
          "type": "string",
          "enum": [
            "floors",
            "radar3d",
            "alertAreas",
            "fireBounds",
            "tropical",
            "fires",
            "lightning",
            "precip",
            "clouds",
            "fx",
            "totals",
            "safety",
            "paths",
            "savedPaths",
            "avoidAreas",
            "buildings",
            "streets",
            "walkways",
            "context",
            "corridors",
            "grid",
            "elevation",
            "waysOut",
            "streetPhoto"
          ]
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "screen",
        "layer",
        "on"
      ],
      "additionalProperties": false
    }
  },
