  {
    "type": "function",
    "name": "frame_screen",
    "description": "Point one screen’s camera, as the remote does: the storm on the Weather screen, the reported floor or a person on the Site screen; or clear its selection.",
    "parameters": {
      "type": "object",
      "properties": {
        "screen": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ]
        },
        "subject": {
          "type": "string",
          "enum": [
            "storm",
            "floor",
            "person",
            "clear"
          ]
        },
        "person": {
          "type": "string",
          "pattern": "^twin-[A-Za-z0-9-]{1,40}$"
        }
      },
      "required": [
        "screen",
        "subject"
      ],
      "additionalProperties": false
    }
  },
