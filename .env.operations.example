# Copy to .env.local. Public Supabase key only — NEVER a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Fixed server-side Core origin; the browser uses /api/safetrekr/operations.
SAFETREKR_CORE_URL=http://127.0.0.1:8002
# Optional. Enable Google Map Tiles API and restrict this browser key by referrer.
GOOGLE_MAPS_API_KEY=
# Optional server-side Street View fallback. Separate from the browser key.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional alternative route to Google 3D via Cesium ion.
CESIUM_ION_TOKEN=

# Live aircraft authentication. Get an OAuth API client from OpenSky.
OPENSKY_AUTH_MODE=oauth
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional London catalog allowance; current public camera packs work keylessly.
TFL_APP_KEY=

# Optional server-side public context providers. No VITE_ prefix.
TOMTOM_API_KEY=
FIRMS_MAP_KEY=
AISSTREAM_API_KEY=

# Full setup and camera coverage: PROVIDER_SETUP.md
