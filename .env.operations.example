# Copy to .env.local. Public Supabase key only — NEVER a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Fixed server-side Core origin; the browser uses /api/safetrekr/operations.
SAFETREKR_CORE_URL=http://127.0.0.1:8001
# Optional. Enable Google Map Tiles API and restrict this browser key by referrer.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=
